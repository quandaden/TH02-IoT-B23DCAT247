# HiveMQ Docker on the Windows host
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=ptit/b23dcat247/sensors
MQTT_TLS_ENABLED=false
MQTT_TLS_INSECURE=false

# InfluxDB local Docker service
INFLUX_URL=http://localhost:8086
INFLUX_ORG=ptit
INFLUX_TOKEN=CHANGE_TO_A_LONG_RANDOM_TOKEN
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
INFLUX_RAW_BUCKET=iot_raw
INFLUX_PROCESSED_BUCKET=iot_processed
INFLUX_RAW_RETENTION_SECONDS=604800
INFLUX_PROCESSED_RETENTION_SECONDS=2592000

# Processing and dashboard
RESAMPLE_FREQUENCY=10s
ROLLING_WINDOW=3
DASHBOARD_REFRESH_SECONDS=5

